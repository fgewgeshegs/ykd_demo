# ============================================
# Claw Assistant Configuration
# ============================================

# Weather API Configuration


# --- WeatherAPI.com (https://www.weatherapi.com) ---
weather.api.url=https://api.weatherapi.com/v1/current.json?key={key}&q={city}&lang=zh
weather.api.key=

# ============================================
# Web Search API Configuration — Tavily (https://tavily.com)
# ============================================
# Tavily 专为 AI Agent 设计：返回结构化结果 + AI 摘要 + 来源引用
# 注册获取 API Key: https://app.tavily.com
websearch.api.key=
websearch.api.url=https://api.tavily.com/search
# 搜索深度: basic(快速) / advanced(深入)
websearch.api.search-depth=basic
# AI 摘要: basic(简短) / advanced(详细)
websearch.api.include-answer=basic
websearch.api.max-results=5
websearch.api.timeout=15

# ============================================
# WeChat iLink Configuration
# ============================================
wechat.ilink.enabled=true
wechat.ilink.poll-interval-ms=3000
wechat.ilink.login-poll-interval-ms=3000

# ============================================
# LLM Configuration
# ============================================
llm.api-key=
llm.base-url=https://api.deepseek.com
llm.model=deepseek-v4-flash

# ============================================
# Vision Model Configuration
# ============================================
vision.api-key=
vision.base-url=https://dashscope.aliyuncs.com/compatible-mode/v1
vision.model=qwen-vl-max

# ============================================
# Image Generation Configuration
# ============================================
image.api-key=
image.model=qwen-image-2.0
image.base-url=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation

# ============================================
# Voice (ASR + TTS) Configuration
# ============================================
voice.api-key=
voice.asr-base-url=https://dashscope.aliyuncs.com/api/v1/services/audio/transcription/transcription
voice.asr-model=paraformer-v2
voice.tts-base-url=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer
voice.tts-model=cosyvoice-v2
voice.tts-voice=longxiaochun_v2

# ============================================
# File Parse Configuration
# ============================================
file.parse.max-file-size=10485760
file.parse.max-text-length=30000
file.parse.max-embedded-images=5
file.parse.max-analyzed-embedded-images=3

# ============================================
# Tencent Map Configuration
# ============================================
# 腾讯位置服务（lbs.qq.com）API 密钥
tencent.key=

place-image.provider=pexels

# ============================================
# Pexels API Configuration
# ============================================
# Pexels åè´¹ API Key æ³¨åå°å: https://www.pexels.com/api/
pexels.api-key=
# ============================================
# Long-Term Memory (Qdrant + BGE-M3)
# ============================================
# 总开关
memory.enabled=true
# 记忆重要性阈值：低于此值不入库（0.0~1.0）
memory.importance-threshold=0.3
# 每次召回的记忆条数（Top-K）
memory.recall-top-k=5
# 召回最低相似度：低于此值的记忆不注入
memory.recall-min-score=0.45
# 先多召回候选，再综合相关度、重要性和时间排序
memory.recall-candidate-multiplier=3
# 普通记忆的新鲜度半衰期（天）
memory.recency-half-life-days=180
# 单用户记忆提取线程池
memory.async-core-size=1
memory.async-max-size=2
memory.async-queue-capacity=50
# 去重相似度阈值：高于此值视为重复
memory.dedup-similarity=0.90
# 用户消息最短长度：低于此值跳过提取
memory.min-extract-length=10

# Qdrant 向量数据库
memory.qdrant.host=localhost
memory.qdrant.port=6334
memory.qdrant.collection=claw_memories
memory.qdrant.vector-dimension=1024

# Embedding 模型（BGE-M3，需 OpenAI 兼容的 /v1/embeddings 端点）
memory.embedding.base-url=http://localhost:11434
memory.embedding.api-key=
memory.embedding.model=bge-m3
memory.embedding.dimension=1024
